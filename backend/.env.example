# --- VeriScope AI backend configuration ---
# The app runs fully in DEMO MODE with none of these set.
# Everything below is an OPTIONAL enhancement.

# Gemini API key. If unset, agents use deterministic local heuristics
# instead of LLM calls (planning, claim synthesis, stance checks).
GEMINI_API_KEY=

# Gemini model name (only used if GEMINI_API_KEY is set).
GEMINI_MODEL=gemini-1.5-flash

# PostgreSQL connection string. If unset, VeriScope uses in-memory
# storage and all data resets on server restart.
# Example: postgresql+psycopg2://veriscope:veriscope@localhost:5432/veriscope
DATABASE_URL=

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host/port the API binds to.
API_HOST=0.0.0.0
API_PORT=8000
